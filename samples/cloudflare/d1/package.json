{
  "name": "pongo-sample-cloudflare-d1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shopping cart sample using Pongo, Hono, and Cloudflare D1",
  "scripts": {
    "setup": "cat .nvmrc | nvm install; nvm use",
    "dev": "wrangler dev --var ENVIRONMENT:development",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "node scripts/deploy.ts",
    "types:cloudflare": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --strict-vars=false",
    "types:cloudflare:check": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --strict-vars=false --check",
    "build:ts": "tsc -b",
    "build:ts:watch": "tsc -b --watch",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:prettier": "prettier --cache --check \"**/**/*.{json,md}\"",
    "lint:eslint": "eslint --cache '**/*.ts'",
    "fix": "run-s fix:eslint fix:prettier",
    "agent:check": "run-s fix build:ts",
    "fix:prettier": "prettier --cache --write \"**/**/*.{json,md}\"",
    "fix:eslint": "eslint --cache '**/*.ts' --fix",
    "test": "run-s test:unit test:int test:e2e",
    "test:unit": "vitest run src/shoppingCarts/businessLogic.unit.spec.ts",
    "test:int": "vitest run src/shoppingCarts/api.int.spec.ts",
    "test:e2e": "vitest run src/shoppingCarts/api.e2e.spec.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@event-driven-io/dumbo": "0.13.0-rc.1",
    "@event-driven-io/emmett": "0.43.0-beta.54",
    "@event-driven-io/emmett-honojs": "0.43.0-beta.54",
    "@event-driven-io/pongo": "0.17.0-rc.1",
    "hono": "4.13.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261025.1",
    "@eslint/js": "10.0.1",
    "@hono/node-server": "1.19.17",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.13.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
