{
  "name": "pongo-sample-simple",
  "version": "1.0.0",
  "type": "module",
  "description": "Simple sample using Pongo ",
  "scripts": {
    "setup": "cat .nvmrc | nvm install; nvm use",
    "build": "tsdown",
    "build:ts": "tsc -b",
    "build:ts:watch": "tsc -b --watch",
    "start": "tsx ./src/index.ts",
    "start:shim": "tsx ./src/shim.ts",
    "start:typed": "tsx ./src/typedClient.ts",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:prettier": "prettier --cache --check \"**/**/*.{json,md}\" \"!docker/**\"",
    "lint:eslint": "eslint --cache '**/*.ts'",
    "fix": "run-s fix:eslint fix:prettier",
    "fix:prettier": "prettier --cache --write \"**/**/*.{json,md}\" \"!docker/**\"",
    "fix:eslint": "eslint --cache '**/*.ts' --fix",
    "test": "run-s test:unit test:int test:e2e",
    "test:unit": "vitest run .unit.spec",
    "test:int": "vitest run .int.spec",
    "test:e2e": "vitest run .e2e.spec",
    "test:watch": "vitest",
    "test:unit:watch": "vitest .unit.spec",
    "test:int:watch": "vitest .int.spec",
    "test:e2e:watch": "vitest .e2e.spec",
    "migrate": "pongo migrate run --config ./dist/pongo.config.js --connectionString postgresql://postgres:postgres@localhost:5432/postgres",
    "shell": "pongo shell",
    "agent:check": "run-s fix build:ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/event-driven-io/Pongo.git"
  },
  "keywords": [
    "Event Sourcing"
  ],
  "author": "Oskar Dudycz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/event-driven-io/Pongo/issues"
  },
  "homepage": "https://github.com/event-driven-io/Pongo#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "tsdown": "0.23.2",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.5"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@event-driven-io/dumbo": "0.13.0-rc.1",
    "@event-driven-io/pongo": "0.17.0-rc.1",
    "pg": "8.23.1"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
