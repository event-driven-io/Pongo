{
  "extends": "../../tsconfig.shared.json",
  "include": ["./src/**/*"],
  "exclude": [
    "./src/storage/sqlite/durableObject/**/*.int.spec.ts",
    "./src/storage/sqlite/durableObject/**/*.e2e.spec.ts",
    "./src/e2e/sqlite/durableObject/**/*.int.spec.ts",
    "./src/e2e/sqlite/durableObject/**/*.e2e.spec.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "outDir": "./lib" /* Redirect output structure to the directory. */,
    "tsBuildInfoFile": "./lib/tsconfig.tsbuildinfo",
    "rootDir": "./src",
    "paths": {
      "@event-driven-io/dumbo": ["../dumbo/src"],
      "@event-driven-io/dumbo/*": ["../dumbo/src/*"],
      "@event-driven-io/pongo-shims/mongodb": ["../pongo-shims/src/mongodb.ts"]
    }
  },
  "references": [
    { "path": "../pongo-shims/" },
    {
      "path": "../dumbo/"
    },
    {
      "path": "../testing/"
    }
  ]
}
