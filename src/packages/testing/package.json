{
  "name": "@event-driven-io/testing",
  "version": "0.1.0",
  "description": "Shared database containers for integration tests",
  "type": "module",
  "private": true,
  "scripts": {
    "build:ts": "tsc -b",
    "test": "vitest run",
    "test:int": "vitest run \".int.spec\""
  },
  "exports": {
    "./postgresql": "./src/postgresql/index.ts",
    "./postgresql/globalSetup": "./src/postgresql/sharedPostgreSQLGlobalSetup.ts",
    "./mongodb": "./src/mongodb/index.ts",
    "./mongodb/globalSetup": "./src/mongodb/sharedMongoDBGlobalSetup.ts"
  },
  "peerDependencies": {
    "@testcontainers/mongodb": "^12.2.1",
    "@testcontainers/postgresql": "^12.2.1",
    "mongodb": "^7.7.0",
    "pg": "^8.23.1",
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "@testcontainers/mongodb": {
      "optional": true
    },
    "@testcontainers/postgresql": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
